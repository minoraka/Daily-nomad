msgid "Students must choose a group."
msgstr "Студент должен выбрать поток."

msgid "Teachers do not belong to a group."
msgstr "У преподавателя не может быть потока."

msgid "Unknown or foreign task."
msgstr "Неизвестная или чужая задача."

msgid "Daily for today already exists."
msgstr "Дейлик на сегодня уже написан."

msgid "You can only edit today's daily."
msgstr "Изменять можно только сегодняшний дейлик."

msgid "Student"
msgstr "Студент"

msgid "Teacher"
msgstr "Преподаватель"

msgid "Planned"
msgstr "Планирую"

msgid "In progress"
msgstr "В работе"

msgid "Done"
msgstr "Готово"

msgid "No active account found with the given credentials"
msgstr "Неверный логин или пароль."

msgid "Given token not valid for any token type"
msgstr "Токен недействителен."

msgid "Token is invalid"
msgstr "Токен недействителен."

msgid "Token is expired"
msgstr "Срок действия токена истёк."

msgid "Token is invalid or expired"
msgstr "Токен недействителен или истёк."

#, python-brace-format
msgid "Invalid pk \"{pk_value}\" - object does not exist."
msgstr "Неверный id \"{pk_value}\" — объект не существует."

msgid "Choose either assignees or group."
msgstr "Укажите либо студентов, либо поток."

msgid "Unknown group."
msgstr "Такого потока нет."

msgid "No students in this group."
msgstr "В этом потоке нет студентов."

msgid "Only students can be assignees."
msgstr "Назначать задачи можно только студентам."

msgid "Allowed estimates: 1, 2, 3, 5, 8."
msgstr "Допустимые оценки: 1, 2, 3, 5, 8."

msgid "At most 5 labels."
msgstr "Не больше 5 меток."

msgid "Label is too long (max 24)."
msgstr "Слишком длинная метка (максимум 24 символа)."

msgid "Labels must be a list of strings."
msgstr "Метки должны быть списком строк."

msgid "In review"
msgstr "На проверке"

msgid "Low"
msgstr "Низкий"

msgid "Medium"
msgstr "Средний"

msgid "High"
msgstr "Высокий"

msgid "Critical"
msgstr "Критичный"
